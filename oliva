#!/usr/bin/env bash
# oliva — entry point único del framework. Dispatcher puro: envuelve los
# scripts existentes en scripts/oliva/ y scripts/*.sh con nombres estables.
# No inventa lógica propia (salvo `doctor`, ver abajo) ni agrupa comandos:
# toda la inteligencia queda en los scripts. Ver docs/roadmap/epics/E-capa-agentica.md.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

usage() {
  cat <<'EOF'
Uso: oliva <comando> [args...]

Framework:
  deps <due|report|update|audit|scan-images>   scripts/oliva/deps.sh
  sync <check|start|locks|verify|pending|ack>  scripts/oliva/sync.sh
  ack                                          = sync ack (acciones de upgrade hechas en esta máquina)
  verify                                       scripts/oliva/verify.sh
  release X.Y.Z                                scripts/oliva/release.sh
  env <init|check [--prod]>                    scripts/oliva/env.sh (.env: crearlo/repararlo, o chequear lo que resuelve Compose)

Operación:
  deploy                                       scripts/deploy.sh
  deploy-staging                               scripts/deploy-staging.sh
  down                                         scripts/down.sh
  down-staging                                 scripts/down-staging.sh

Diagnóstico:
  doctor                                       chequeos de sanidad (read-only)
  version                                      imprime OLIVA_VERSION
  help                                         esta ayuda
EOF
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
  deps)          exec scripts/oliva/deps.sh "$@" ;;
  sync)          exec scripts/oliva/sync.sh "$@" ;;
  ack)           exec scripts/oliva/sync.sh ack ;;
  verify)        exec scripts/oliva/verify.sh "$@" ;;
  release)       exec scripts/oliva/release.sh "$@" ;;
  env)           exec scripts/oliva/env.sh "$@" ;;
  deploy)        exec scripts/deploy.sh "$@" ;;
  deploy-staging) exec scripts/deploy-staging.sh "$@" ;;
  down)          exec scripts/down.sh "$@" ;;
  down-staging)  exec scripts/down-staging.sh "$@" ;;
  version)       cat OLIVA_VERSION ;;
  help|-h|--help) usage ;;
  doctor)
    # Diagnóstico read-only: ningún paso puede matar al comando. Cada paso
    # corre aislado y, si falla, informa y sigue (ver gotcha de `set -e` en
    # el epic de la capa agéntica — doctor debe sobrevivir con Docker abajo).
    step() {
      local label="$1"; shift
      echo
      echo "── $label ──"
      if "$@"; then return 0; else
        echo "   (no disponible: salió $?)"
        return 0
      fi
    }

    step "rama" git branch --show-current
    step "status" git status -s
    step "log" git log --oneline -3
    step "docker compose ps" docker compose ps
    step "migraciones" docker compose exec backend bin/console doctrine:migrations:status
    # Lo que Compose RESUELVE para cada servicio (no lo que dice el .env): secretos
    # faltantes/públicos, slots reemplazados. Informa; el exit code no corta a doctor.
    env_board() { scripts/oliva/env.sh check || true; }
    step "env" env_board
    step "deps due" scripts/oliva/deps.sh due
    # Acciones de UPGRADING.md sin guard que esta máquina no reconoció (./oliva ack).
    # Después de un sync es lo único que sigue mostrándolas: check ya da "al día".
    step "acciones de upgrade" scripts/oliva/sync.sh pending

    # Last CI run on main, of THIS repo: the one `origin` points at. Asking `gh` without
    # naming the repo let it fall back to another remote, so an app with no `origin`
    # was shown Oliva's green run as if it were its own (friction log X2).
    # Why it is here at all: a build can pass locally and break in CI (one app stayed
    # red through nine syncs with nothing saying so). Without `gh`, it is skipped.
    ci_repo() {
      local url
      url="$(git remote get-url origin 2>/dev/null)" || return 1
      [[ "$url" =~ github\.com[:/]([^/]+/[^/]+)$ ]] || return 2
      echo "${BASH_REMATCH[1]%.git}"
    }
    ci_status() {
      local out
      out="$(timeout 10 gh run list -R "$1" --branch main -L 1 \
        --json conclusion,status,displayTitle,createdAt,databaseId \
        --jq '.[0] | "\(.conclusion // .status)\t\(.createdAt[:10])\t\(.displayTitle)\t\(.databaseId)"')" || return 1
      [[ -n "$out" ]] || { echo "   (no runs on main in $1)"; return 0; }
      local concl date title id
      IFS=$'\t' read -r concl date title id <<< "$out"
      echo "   $concl  $date  $title"
      [[ "$concl" == failure ]] && echo "   !! CI ROJO en main. Ver: gh run view $id -R $1 --log-failed"
      return 0
    }
    repo=""; repo_rc=0
    repo="$(ci_repo)" || repo_rc=$?
    if (( repo_rc == 1 )); then
      echo
      echo "── CI (último run en main) ──"
      echo "   !! no \`origin\` remote: this repo has no CI and no security alerts of its own."
      echo "      Nothing checks what you push. Fix: git remote add origin <your-repo-url> && git push -u origin main"
    elif (( repo_rc == 2 )); then
      echo
      echo "── CI (último run en main) ──"
      echo "   (omitido: \`origin\` no es un repo de GitHub)"
    elif command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
      step "CI (último run en main)" ci_status "$repo"
    else
      echo
      echo "── CI (último run en main) ──"
      echo "   (omitido: gh no está instalado o no está logueado)"
    fi

    if git remote get-url oliva-upstream >/dev/null 2>&1; then
      step "sync check" scripts/oliva/sync.sh check
    else
      echo
      echo "── sync check ──"
      echo "   (omitido: no hay remote oliva-upstream — este no es un fork)"
    fi
    ;;
  *)
    echo "oliva: comando desconocido: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
