# The frontend behind the gateway: a plain static server, nothing else.
# Routing, CSP, trusted_proxies, compression and logging all live in
# gateway/Caddyfile. Keeping two layers of each (headers, encode) would double
# the work on every request and let the two drift. One place per concern.
:80 {
    root * {$FRONTEND_DOC_ROOT:/usr/share/caddy}

    # Immutable-asset caching stays here (per-asset, lives naturally with the
    # files). The gateway's reverse_proxy forwards Cache-Control untouched.
    @cacheable {
        path *.css *.js *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2
    }
    header @cacheable Cache-Control "public, max-age=31536000, immutable"

    file_server

    # Optional SPA fallback (opt-in; a fork that needs it adds this line):
    # try_files {path} /index.html
}
