# Compose — servicios opcionales (Docker Compose profiles)
# Vacío = solo core (backend + frontend + database). Mercure va siempre embebido en el backend.
# Activar perfiles separados por coma. Perfiles disponibles:
#   queues  → rabbitmq (+ worker en dev). Requiere RABBITMQ_USER/PASSWORD/DSN.
#   cron    → scheduler (supercronic). Requiere llenar backend/scheduler/crontab.
# OJO: un profile que la app necesita y nadie activó falla en silencio — el servicio
# simplemente no levanta, sin error. Ej.: COMPOSE_PROFILES=queues,cron
# En prod vale el .env DEL HOST (lo lee el `up` de scripts/deploy.sh). Si el crontab tiene
# tareas y `cron` no está acá, deploy.sh/deploy-staging.sh lo avisan al final.
COMPOSE_PROFILES=

# Queue consumer outside this stack (rare). If the app routes messages to an asynchronous
# transport, verify and the deploys require a worker here (profile `queues`) and refuse a
# worker on the default vhost of a shared broker. When the messages are consumed by another
# service or host on purpose, declare it; doctor and the deploys then say so on every run.
# OLIVA_QUEUE_CONSUMER=external

# Dev host ports (solo dev, docker-compose.override.yml)
# Los puertos que la app PUBLICA en tu máquina. Una sola app: dejá esto como está,
# toma los defaults de abajo (gateway :80, database :5432). Para correr una SEGUNDA
# app Oliva a la vez (que si no choca con "port is already allocated"), descomentá y
# poné otros valores en el `.env` de ESA app. El puerto interno del container no
# cambia; solo el lado-host.
#
# Desde 1.9.0 el único puerto HTTP publicado es el del gateway (ver E-unbundle-roles):
# backend y frontend viven en app_network y se alcanzan a través del gateway.
# BACKEND_PORT/FRONTEND_PORT en un .env de una app pre-1.9.0 queda sin uso; el
# upgrade-guard `dev-ports` lo avisa en verify/doctor.
# GATEWAY_PORT=80
# DB_PORT=5432
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672

# Gateway upstreams (solo dev, docker-compose.override.yml)
# A quién redirige cada ruta del gateway. Vacío = defaults del Caddyfile
# (backend:80 para /api, /health, /.well-known/mercure; frontend:3000 en dev,
# frontend:80 en prod). Cambiar un upstream por otro servicio reemplaza el slot
# sin tocar Oliva (el "probe" de la fase 3 de E-unbundle-roles). Al sobrescribir
# uno, `env check` lo reporta como REPLACED.
# GATEWAY_BACKEND_UPSTREAM=backend:80
# GATEWAY_FRONTEND_UPSTREAM=frontend:3000
# GATEWAY_REALTIME_UPSTREAM=backend:80
# GATEWAY_TRUSTED_PROXIES=private_ranges

# Backend trusted proxies (solo si querés acotarlos)
# La imagen del backend hornea `SYMFONY_TRUSTED_PROXIES=PRIVATE_SUBNETS`
# (RFC 1918 + IPv6 ULA), que es el rango del gateway y, en shared-infra, del
# edge proxy. Sobrescribí solo si tu red interna NO es privada (muy raro) o
# querés acotar más. NUNCA setees SYMFONY_TRUSTED_HEADERS (ver env-check).
# SYMFONY_TRUSTED_PROXIES=PRIVATE_SUBNETS

# Dev container user (solo dev, docker-compose.override.yml)
# En dev los containers del backend corren como ESTE usuario, para que lo que escriben
# en los bind-mounts (claves JWT, migración generada, cache de var) quede tuyo y no
# root-owned (si no, no podés borrar el dir sin `sudo chown`). El default es 1000:1000,
# el UID/GID del primer usuario en la mayoría de los Linux. Si tu `id -u` NO es 1000,
# descomentá y poné tus valores. Prod no usa esto (corre como root, es lo correcto ahí).
# HOST_UID=1000
# HOST_GID=1000

# Backend
SERVER_NAME=localhost
CADDY_MERCURE_URL=http://localhost/.well-known/mercure
CADDY_MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
MERCURE_TRANSPORT_URL=some_transport_url
MERCURE_PUBLISHER_JWT_ALG=HS256
MERCURE_SUBSCRIBER_JWT_ALG=HS256
MERCURE_EXTRA_DIRECTIVES=""

# Caddy
CADDY_GLOBAL_OPTIONS=""
# FRANKENPHP_CONFIG: NO definir acá. La imagen de prod (frankenphp_prod) ya hornea
# `import worker.Caddyfile` → worker mode ON por defecto en prod. Definir esta variable
# (aunque sea vacía) en este env_file la inyecta en TODOS los entornos y PISA la imagen,
# apagando worker mode en prod en silencio (bug hasta 1.4.3). Para correr clásico en prod
# es un opt-out deliberado: agregar `FRANKENPHP_CONFIG=` vacío al `environment:` de
# docker-compose.prod.yml (ver backend/docs/production.md), nunca acá.
CADDY_EXTRA_CONFIG=""
CADDY_SERVER_LOG_OPTIONS=""
FRONTEND_DOC_ROOT=/usr/share/caddy

# Database (standalone: la app levanta su propio Postgres `database`)
# DATABASE_URL es la conexión del backend. En standalone SUS CREDENCIALES DEBEN
# COINCIDIR con POSTGRES_USER/PASSWORD/DB de acá (es el mismo Postgres, escrito dos
# veces). Shared infra: set DATABASE_URL HERE (in the host's .env) to the provisioned URL
# of the shared Postgres. Never in .env.backend: that file is tracked.
POSTGRES_USER=app
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=app
POSTGRES_VERSION=15
DATABASE_URL=postgresql://app:your_db_password@database:5432/app?serverVersion=15&charset=utf8

# Secrets (APP_SECRET, JWT_PASSPHRASE, passwords, Mercure keys) live ONLY in .env.
# .env.backend is tracked and loads after this file: a secret there is public and wins.

# Symfony
SYMFONY_VERSION=7.x
STABILITY=stable
APP_SECRET=your_app_secret

#Environmental
APP_ENV=dev
NODE_ENV=development

#JWT
JWT_PASSPHRASE=your_passphrase_here

# RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_DSN=amqp://app:your_rabbitmq_password@rabbitmq:5672/%2f

# Mercure
MERCURE_PUBLISHER_JWT_KEY=generate_with_openssl_rand_hex_32
MERCURE_JWT_SECRET=generate_with_openssl_rand_hex_32
# Since 1.10.0 the hub is the `realtime` service (profile `realtime`). MERCURE_URL (the
# internal POST target) lives in .env.backend, pointing at it by name. MERCURE_PUBLIC_URL
# (advertised to browsers) stays on the gateway's origin. Only override per host if needed.
MERCURE_URL=http://realtime/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure

# Realtime hub history (profile `realtime`): how many recent events bolt keeps for clients
# that reconnect with Last-Event-ID. Lost on a deploy, kept across a restart; no volume.
# REALTIME_HISTORY_SIZE=1000

# Seeding (staging only — requires frankenphp_staging image, unavailable in prod)
# ⚠️ fixtures:load PURGES the DB before loading. Run ONLY against a dedicated staging
#    database, NEVER against a production app's DB in shared infra. See Epic E "Deuda crítica".
# docker compose -f docker-compose.yml -f docker-compose.prod.yml build --target frankenphp_staging backend
# docker exec <app>-staging-backend-1 bin/console doctrine:fixtures:load --group=staging --no-interaction