# Non-secret defaults for the backend. This file is TRACKED: never put a secret here.
#
# It is loaded AFTER .env, so anything defined here overrides .env without a word.
# Until Oliva 1.6.0 it carried APP_SECRET, JWT_PASSPHRASE and the Mercure keys, which
# made every app run on values that are public in git. Secrets (and DATABASE_URL, in
# standalone or shared infra alike) live in .env, which is gitignored.
# See docs/roadmap/epics/E-config-contract.md.

# Symfony
SERVER_NAME=0.0.0.0:80
HTTP_PORT=80

# Do NOT add a variable with the PHP version here. The version is set by the exact tag
# of the base image in backend/Dockerfile (FROM ... AS frankenphp_upstream), the only
# source of truth: nothing at runtime reads it from an env var. There used to be a
# `PHP_VERSION=8.3.13` here that nobody consumed and fell 23 patches behind; it read as
# the project's version, so bumping it looked like applying a CVE fix.

# Caddy
CADDY_GLOBAL_OPTIONS=#
CADDY_EXTRA_CONFIG=#
CADDY_SERVER_LOG_OPTIONS=#
CADDY_SERVER_EXTRA_DIRECTIVES=#

# Mercure hub URLs (the keys are secrets: they live in .env)
MERCURE_URL=http://localhost/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure
